<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.diffusion.kicker}"/>
    <Label class="h-title" text="{tr help.diffusion.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.diffusion.p1}"/>
    <Label class="h-p" text="{tr help.diffusion.p2}"/>
    <Stack class="h-figure" direction="vertical">
        <Component class="h-diagram dg-230" paint="{binding diagram1}"/>
        <Label class="h-caption" text="{tr help.diffusion.fig3}"/>
    </Stack>
    <Label class="h-p" text="{tr help.diffusion.p4}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="x_t = \sqrt{\bar\alpha_t}\; x_0 + \sqrt{1-\bar\alpha_t}\; \varepsilon"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="x_0"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.diffusion.legend8_0}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="x_t"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.diffusion.legend8_1}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\varepsilon"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.diffusion.legend8_2}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\bar\alpha_t"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.diffusion.legend8_3}"/>
        </Stack>
    </Stack>
    <Label class="h-head" text="{tr help.h.where}"/>
    <Label class="h-p" text="{tr help.diffusion.p10}"/>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.diffusion.q12_0}"/>
            <Label class="h-a" text="{tr help.diffusion.a12_0}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.diffusion.try}" command="{binding tryIt}"/>
</Stack>
