<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.unet.kicker}"/>
    <Label class="h-title" text="{tr help.unet.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.unet.p1}"/>
    <Stack class="h-figure" direction="vertical">
        <Component class="h-diagram dg-270" paint="{binding diagram1}"/>
        <Label class="h-caption" text="{tr help.unet.fig2}"/>
    </Stack>
    <Label class="h-p" text="{tr help.unet.p3}"/>
    <Label class="h-p" text="{tr help.unet.p4}"/>
    <Label class="h-head" text="{tr help.h.where}"/>
    <Label class="h-p" text="{tr help.unet.p6}"/>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.unet.q8_0}"/>
            <Label class="h-a" text="{tr help.unet.a8_0}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.unet.try}" command="{binding tryIt}"/>
</Stack>
